---
/**
 * Player profile, scoped to one tournament. There is no cross-tournament player identity —
 * this page is "what this nick did in this event", nothing more.
 *
 * Results are shown from THIS player's perspective (1 / ½ / 0), not in pairing orientation,
 * with the raw pairing result in the tooltip.
 *
 * Two markers can appear on a row, and they mean different things on purpose:
 *   🚫 sits next to a NICK whose playzone account is blocked — the opponent's, never this page's
 *      owner (his blockade is stated once, in the banner, rather than repeated on every row);
 *   ⚠️ sits on a RESULT decided by the regulation rather than on the board.
 * An honest opponent of a blocked player is never marked 🚫.
 */
import TournamentLayout from '../../../layouts/TournamentLayout.astro';
import { playerPaths } from '@lib/site';
import {
  BLOCKED_ICON, FORFEIT_ICON, SWAP_HINT,
  blockedLabel, formatPoints, hasAssignedColors, platformLabel, playerPageUrl, profileUrl,
} from '@lib/display';
import { computeStandings, playerGames, tournamentProgress } from '@lib/standings';
import { blockOf } from '@lib/forfeit';
import type { Tournament } from '@lib/manifest';
import ExternalIcon from '../../../components/ExternalIcon.astro';
import BoardIcon from '../../../components/BoardIcon.astro';

export function getStaticPaths() {
  return playerPaths();
}

const { tournament, nick } = Astro.props as { tournament: Tournament; nick: string };
const t = tournament;
const base = `/${t.slug}`;

const player = (t.players ?? []).find((p) => p.nick.toLowerCase() === nick.toLowerCase());
const standing = computeStandings(t).find((s) => s.nick.toLowerCase() === nick.toLowerCase());
const games = playerGames(t, nick);
const showSwapWarning = hasAssignedColors(t.type);

/**
 * No place while nothing is resolved: every player sits on 0 and the standings sort collapses to
 * the alphabetical tie-break, which would hand this player a rank — and possibly a medal — for
 * having a nick that sorts early. Points stay visible; 0 is genuinely what the manifest says.
 *
 * Keyed off the DATA, never off the calendar: this page is a static snapshot rebuilt only when a
 * commit lands, so it has no idea what day it is when someone reads it.
 */
const hasResults = tournamentProgress(t).resolved > 0;

const medals: Record<number, string> = { 1: '🥇', 2: '🥈', 3: '🥉' };
/** Podium gets its medal; everyone from 4th down gets a plain trophy. */
const placeSymbol = hasResults && standing ? (medals[standing.place] ?? '🏆') : null;
const initial = nick.slice(0, 1).toUpperCase();

/** This page's own owner. Drives the banner; never a per-row badge. */
const myBlock = blockOf(t, nick);

const FORFEIT_HINT =
  'Walkower — konto przeciwnika zostało zablokowane na platformie. Zgodnie z regulaminem partia ' +
  'jest przegrana dla niego; wynik partii może być inny, niż pokazany tutaj.';
const OWN_FORFEIT_HINT =
  'Walkower — partia przegrana wskutek blokady konta. Wynik partii może być inny, niż pokazany tutaj.';

const outcome = (score: number | null) =>
  score === null ? '' : score === 1 ? 'win' : score === 0 ? 'loss' : 'draw';

/**
 * The colour column doubles as the link to the game — the pawn plus its label say which colour
 * this player had, and clicking opens that game on the playzone. This is why it is the colour cell
 * and not a column of its own: a double round-robin puts BOTH pawns here, each linking to its own
 * game, with a single match total in the result column.
 */
type Color = 'white' | 'black' | null;

/**
 * The glyphs are CROSSED relative to their Unicode names, on purpose.
 *
 * Both are painted as text in the inherited colour — light, on this dark-only theme — and
 * U+265F BLACK CHESS PAWN is a SOLID silhouette while U+2659 WHITE CHESS PAWN is a hollow outline.
 * Filled light-on-dark, the "black" glyph reads as a white pawn and the outlined "white" glyph
 * reads as a black one, so mapping them by name puts the wrong pawn on every row. The written
 * label beside it is the authority; the glyph only has to look right.
 */
const pawn = (c: Color) => (c === 'white' ? '♟' : '♙');
const colorName = (c: Color) => (c === 'white' ? 'białe' : 'czarne');
const gameHint = (c: Color) => `Partia — ${colorName(c)}`;
---

<TournamentLayout tournament={t} currentPage="gracze" title={`${nick} — ${t.title}`}>
  <section class="hero">
    {
      player?.avatar ? (
        <img class="avatar" src={player.avatar} alt={nick} width="72" height="72" loading="lazy" />
      ) : (
        <div class="avatar placeholder" aria-hidden="true">
          {initial}
        </div>
      )
    }

    <div class="who">
      <a class="nick-link" href={profileUrl(t.platform, nick)} target="_blank" rel="noopener">
        {nick}{' '}
        <ExternalIcon />
      </a>
      {myBlock && <span class="ban-inline" aria-hidden="true">{BLOCKED_ICON}</span>}
      {player?.name && <p class="realname">{player.name}</p>}
      <p class="rating">
        {
          player?.rating ? (
            <>
              <span class="star" title="Ranking startowy">
                ★
              </span>{' '}
              <strong>{player.rating}</strong>
            </>
          ) : (
            <span class="faint">Brak rankingu</span>
          )
        }
      </p>
    </div>

    <dl class="stats">
      <div>
        <dt>Punkty</dt>
        <dd class="big">{standing ? formatPoints(standing.points) : '—'}</dd>
      </div>
      <div>
        <dt>Miejsce</dt>
        <dd class="big">
          {
            hasResults && standing ? (
              <>
                <span class="place-symbol">{placeSymbol}</span> {standing.place}
              </>
            ) : (
              '—'
            )
          }
        </dd>
      </div>
    </dl>
  </section>

  {
    myBlock && (
      <aside class="ban-note" role="note">
        <p class="ban-title">
          <span aria-hidden="true">{BLOCKED_ICON}</span> {blockedLabel(myBlock)}
        </p>
        <p>
          Na profilu zawodnika na {platformLabel(t.platform)} pojawił się komunikat:{' '}
          <code>{myBlock.reason}</code>. Zgodnie z regulaminem (§ Fair play) oznacza to wykluczenie
          z turnieju — wszystkie partie zostają zweryfikowane jako przegrane, a przeciwnicy
          otrzymują punkt, niezależnie od wyniku osiągniętego przy szachownicy.
        </p>
      </aside>
    )
  }

  <h2 class="games-heading">Partie</h2>

  {
    games.length === 0 ? (
      <p class="empty">Nie ma jeszcze kojarzeń.</p>
    ) : (
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th class="num">Runda</th>
              <th></th>
              <th>Kolor</th>
              <th>Przeciwnik</th>
              <th class="num">Ranking</th>
              <th>Wynik</th>
            </tr>
          </thead>
          <tbody>
            {games.map((g) => (
              <tr class:list={[{ pending: g.score === null }]}>
                <td class="num">
                  <a class="round-link" href={`${base}/rundy/${g.round}`} title={`Runda ${g.round}`}>
                    {g.round}
                  </a>
                </td>
                <td class="board" title={`Szachownica ${g.board}`}>
                  <BoardIcon /> {g.board}
                </td>
                <td class="color">
                  {g.bye ? (
                    <span class="faint">—</span>
                  ) : g.gameUrl ? (
                    <a
                      class="game-link"
                      href={g.gameUrl}
                      target="_blank"
                      rel="noopener"
                      title={gameHint(g.color)}
                    >
                      <span class:list={['pawn', g.color]} aria-hidden="true">
                        {pawn(g.color)}
                      </span>
                      <span class="cname">{colorName(g.color)}</span>
                      <ExternalIcon />
                    </a>
                  ) : (
                    <>
                      <span class:list={['pawn', g.color]} aria-hidden="true">
                        {pawn(g.color)}
                      </span>{' '}
                      <span class="cname">{colorName(g.color)}</span>
                    </>
                  )}
                </td>
                <td>
                  {g.bye ? (
                    <span class="bye">pauza</span>
                  ) : (
                    <>
                      <a class="nick" href={playerPageUrl(t.slug, g.opponent!)}>
                        {g.opponent}
                      </a>
                      {g.opponentBlocked && (
                        <span
                          class="ban"
                          title={blockedLabel(blockOf(t, g.opponent!)!)}
                          aria-label={blockedLabel(blockOf(t, g.opponent!)!)}
                        >
                          {BLOCKED_ICON}
                        </span>
                      )}
                      {g.score === null && (
                        <a
                          class="swords"
                          href={profileUrl(t.platform, g.opponent!)}
                          target="_blank"
                          rel="noopener"
                          title={`Profil ${g.opponent} na ${t.platform === 'lichess' ? 'lichess.org' : 'chess.com'}`}
                        >
                          ⚔️
                        </a>
                      )}
                    </>
                  )}
                </td>
                <td class="num muted">{g.opponentRating ?? ''}</td>
                <td>
                  {g.score === null ? (
                    <span class="faint">—</span>
                  ) : (
                    <>
                      <span
                        class:list={['score', outcome(g.score)]}
                        title={
                          g.bye
                            ? 'Punkt za pauzę'
                            : g.forfeit
                              ? g.opponentBlocked ? FORFEIT_HINT : OWN_FORFEIT_HINT
                              : `Wynik kojarzenia: ${g.result}`
                        }
                      >
                        {formatPoints(g.score)}
                      </span>
                      {g.forfeit ? (
                        <>
                          {g.result && (
                            <s class="played" title={`Rozegrana partia: ${g.result}`}>
                              {g.result}
                            </s>
                          )}
                          <span
                            class="wo"
                            title={g.opponentBlocked ? FORFEIT_HINT : OWN_FORFEIT_HINT}
                            aria-label={g.opponentBlocked ? FORFEIT_HINT : OWN_FORFEIT_HINT}
                          >
                            {FORFEIT_ICON}
                          </span>
                        </>
                      ) : (
                        /* Suppressed on a walkower: once the result is administrative, which
                           colour was actually played is moot, and the two glyphs share a base
                           codepoint — side by side they are unreadable. */
                        g.colorsSwapped &&
                        showSwapWarning && (
                          <span class="warn" title={SWAP_HINT} aria-label={SWAP_HINT}>
                            ⚠
                          </span>
                        )
                      )}
                    </>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</TournamentLayout>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    flex-wrap: wrap;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-raised);
  }

  .avatar {
    width: 72px;
    height: 72px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .avatar.placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--border);
    color: var(--muted);
    font-size: 1.9rem;
    font-weight: 700;
  }

  .who {
    flex: 1;
    min-width: 160px;
  }

  .nick-link {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-strong);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .nick-link:hover {
    color: var(--accent);
  }

  .realname {
    margin-top: 0.15rem;
    font-size: 0.86rem;
    color: var(--muted);
  }

  .rating {
    margin-top: 0.3rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .rating strong {
    color: var(--text-strong);
  }

  .star {
    color: var(--amber);
  }

  .stats {
    display: flex;
    gap: 1.6rem;
  }

  .stats > div {
    text-align: center;
  }

  .stats dt {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--faint);
  }

  .big {
    margin-top: 0.15rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-strong);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Emoji render large for their point size — pull the medal back to match the digits. */
  .place-symbol {
    font-size: 0.82em;
    vertical-align: 0.06em;
  }

  .board {
    white-space: nowrap;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .games-heading {
    margin-top: 1.8rem;
  }

  tr.pending td {
    background: rgba(139, 148, 158, 0.05);
  }

  tr.pending .nick {
    color: var(--muted);
  }

  /* The round number links to that round's page. Kept quiet — it is a number in a table, not a
     call to action; the underline only appears on hover. */
  .round-link {
    color: var(--muted);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  .round-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .color {
    white-space: nowrap;
  }

  .pawn {
    font-size: 1.15rem;
    line-height: 1;
  }

  /* Explicit, so the pair stays legible if the row's inherited colour ever changes (pending rows
     mute their text). Solid glyph light, outlined glyph dimmer — see the note on `pawn()`. */
  .pawn.white {
    color: var(--text-strong);
  }

  .pawn.black {
    color: var(--muted);
  }

  .cname {
    font-size: 0.86rem;
    color: var(--muted);
  }

  .game-link {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
    color: inherit;
    text-decoration: none;
  }

  /* The pawn and the label carry their own colours, so hover has to reach them explicitly or the
     link would give no feedback at all. */
  .game-link:hover,
  .game-link:hover .pawn,
  .game-link:hover .cname {
    color: var(--accent);
  }

  .score {
    display: inline-block;
    min-width: 2.3rem;
    text-align: center;
    padding: 0.05rem 0.35rem;
    border-radius: 4px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    border: 1px solid var(--border-strong);
    color: var(--text-strong);
  }

  .score.win {
    border-color: var(--green);
    color: var(--green);
  }

  .score.loss {
    border-color: var(--red);
    color: var(--red);
  }

  .score.draw {
    border-color: var(--border-strong);
    color: var(--muted);
  }

  .warn {
    margin-left: 0.4rem;
    color: var(--amber);
    cursor: help;
  }

  /* Red, not amber: a walkower is not a colour swap, and ⚠️ (U+26A0 U+FE0F) shares its base
     codepoint with the swap ⚠ (U+26A0). Colour, position and aria-label are what separate them. */
  .wo {
    margin-left: 0.4rem;
    color: var(--red);
    cursor: help;
  }

  .played {
    margin-left: 0.4rem;
    font-size: 0.8em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    cursor: help;
  }

  .ban {
    margin-left: 0.35rem;
    cursor: help;
  }

  .ban-inline {
    margin-left: 0.4rem;
  }

  .ban-note {
    margin: 1rem 0 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--red);
    border-radius: 8px;
    background: color-mix(in srgb, var(--red) 8%, transparent);
    font-size: 0.9rem;
  }

  .ban-note p {
    margin: 0.35rem 0 0;
  }

  .ban-title {
    margin: 0 !important;
    font-weight: 600;
    color: var(--red);
  }

  .ban-note code {
    font-size: 0.85em;
    padding: 0.05rem 0.3rem;
    border-radius: 4px;
    background: var(--surface, rgba(127, 127, 127, 0.15));
  }

  .swords {
    margin-left: 0.45rem;
    text-decoration: none;
  }

  .bye {
    color: var(--muted);
    font-style: italic;
  }
</style>
